PROJECT_NAME=Punahachakrana B2B Recycling Marketplace
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=punahachakrana_db

# Security & JWT Authentication
SECRET_KEY=change_this_super_secret_key_in_production_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (Comma-separated list or JSON string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8443","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:8443"]
